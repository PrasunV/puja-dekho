{
  "name": "puja-dekho",
  "version": "1.0.0",
  "private": true,
  "description": "Durga Puja pandal-hopping map for South Kolkata",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.js\"",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "data": "python3 scripts/build-data.py",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "express": "^4.22.3",
    "maplibre-gl": "^5.24.0",
    "motion": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
