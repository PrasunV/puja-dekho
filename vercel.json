{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/data/pujas.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/jagadhatripuja",
      "destination": "/jagadhatripuja/index.html"
    },
    {
      "source": "/Jagadhatripuja",
      "destination": "/jagadhatripuja/index.html"
    },
    {
      "source": "/JagadhatriPuja",
      "destination": "/jagadhatripuja/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org https://api.openrouteservice.org; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/jagadhatripuja-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jagadhatri",
      "destination": "/jagadhatripuja",
      "permanent": true
    },
    {
      "source": "/Jagadhatri",
      "destination": "/jagadhatripuja",
      "permanent": true
    }
  ]
}
